# Ignore evyerthing in root except src folder and select files
/*
!/src
!gulpfile.js
!package.json
!.gitignore
!.gitattributes
!readme.md
!readme.txt

package-lock.json
yarn.lock

# Ignore all image files except svg

# JPEG
*.jpg
*.jpeg
*.jpe
*.jif
*.jfif
*.jfi
!/src/assets/images/home-*.jpg

# JPEG 2000
*.jp2
*.j2k
*.jpf
*.jpx
*.jpm
*.mj2

# JPEG XR
*.jxr
*.hdp
*.wdp

# Graphics Interchange Format
*.gif

# RAW
*.raw

# Web P
*.webp

# Portable Network Graphics
*.png
!/src/screenshot.png
!/src/favicon/*.png

# Animated Portable Network Graphics
*.apng

# Multiple-image Network Graphics
*.mng

# Tagged Image File Format
*.tiff
*.tif

# Portable Document Format
*.pdf

# X BitMap
*.xbm

# BMP
*.bmp
*.dib

# ICO
*.ico

# 3D Images
*.3dm
*.max

# ignore node dependency directories
node_modules/

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs, Backups, and Databases #
######################
*.log
*.sql
*.sqlite
*.bak

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
!/src/assets/images/verbo-vancouver-logo.svg
!/tools/
!/tools/**
