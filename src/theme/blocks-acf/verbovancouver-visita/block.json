      "full"
    ],
    "anchor": true,
    "alignContent": false,
    "color": {
      "text": false,
      "background": false,
      "link": false
    },
    "alignText": false,
    "fullHeight": false
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
