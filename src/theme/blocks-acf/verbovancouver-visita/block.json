{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "verbovancouver/visita",
  "title": "Planea tu visita",
  "description": "Horario, dirección y cuenta regresiva al próximo servicio.",
  "style": "verbovancouver-visita-css",
