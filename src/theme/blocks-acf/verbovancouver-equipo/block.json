{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "verbovancouver/equipo",
  "title": "Equipo con biografías",
  "description": "Fotos de un grupo de personas; al hacer clic se abre su biografía.",
  "style": "verbovancouver-equipo-css",
  "script": "verbovancouver-equipo",
  "category": "verbovancouver-blocks",
  "icon": "groups",
  "keywords": [
    "equipo",
    "consejo",
    "líderes",
    "alabanza"
  ],
  "acf": {
    "mode": "preview",
    "renderTemplate": "verbovancouver-equipo.php",
    "blockVersion": 3,
    "autoInlineEditing": true,
    "hideFieldsInSidebar": false
  },
  "styles": [],
  "supports": {
    "align": [
      "full"
    ],
    "anchor": true,
    "alignContent": false,
    "color": {
      "text": false,
      "background": false,
      "link": false
    },
    "alignText": false,
    "fullHeight": false
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}